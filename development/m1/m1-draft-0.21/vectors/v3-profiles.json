    "network": {"file": "reference/governance.md", "lines": [4, 16], "literals": ["chainId=777001", "T_blk=60s", "τ=3600s", "nonceMode=0", "D_att=300", "Δ_fb_wait=25", "subsidy=2·10^18", "H_END=129600", "T_END=g_ts+10368000", "H_CLOSE=129440", "T_CLOSE=T_END−9600"]},
