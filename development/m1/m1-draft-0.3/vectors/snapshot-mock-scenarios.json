        },
        {
          "call": "proof1",
          "from": "A"
        },
        {
          "call": "proof2",
          "from": "A"
        }
      ],
      "expected": {
        "result": "render",
        "restarts": 1,
        "frames": 1,
        "mixed": false,
        "anchorState": "A",
        "version": 1,
        "manifestHash": "M_A1",
        "calls": [
          "anchor",
          "proof1",
          "proof2",
          "anchor",
          "proof1",
          "proof2"
        ]
      }
    },
    {
      "id": "SNAP-03D-A-B-A-detector-only",
      "mechanism": "detectorB",
      "request": {
        "kind": "default"
      },
      "description": "Alternative (B) on the same A -> B -> A sequence. Both endpoint hashes are H_A, so the detector passes and the viewer renders v1 content from B as the current version of A. This scenario must produce a mixed render: it is the executable demonstration that (B) is a detector, not a guarantee.",
      "script": [
        {
          "call": "hashAt",
          "from": "A"
        },
        {
          "call": "read1",
          "from": "A"
        },
        {
          "call": "read2",
          "from": "B"
        },
        {
          "call": "hashAt",
          "from": "A"
        }
      ],
      "expected": {
        "result": "render",
        "restarts": 0,
        "frames": 1,
        "mixed": true,
        "version": 1,
        "manifestHash": "M_B1",
        "neverCurrentInAnyState": true,
        "calls": [
          "hashAt",
          "read1",
          "read2",
          "hashAt"
        ]
      }
    },
