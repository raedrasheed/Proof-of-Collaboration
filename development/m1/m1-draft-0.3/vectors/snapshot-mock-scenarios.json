{
  "specVersion": "M1 draft 0.3",
  "revision": "R3-04 (C06)",
  "status": "MOCK scenarios over an ABSTRACT proof model (tools/snapshot_model.py). They specify the required client behaviour and make it falsifiable. They are not evidence that pocold serves eth_getProof, that MPT proofs verify, or that the baseline permits the extension to send eth_getProof (see M1-OPEN-0.3.md BLK-01).",
  "callMeaning": {
    "anchor": "eth_getBlockByNumber('latest', false) in LN, or the head header verified by the RP window; returns {number, hash, stateRoot} of the named state",
    "proof1": "eth_getProof(website, [slot 2], N): versionCount and currentVersion",
    "proof2": "eth_getProof(website, [Version[n] base, base+1, base+2, element slots], N)",
    "hashAt": "alternative B only: eth_getBlockByNumber(N).hash",
    "read1": "alternative B only: eth_getStorageAt(website, slot 2, N), unverified",
    "read2": "alternative B only: eth_getStorageAt of the Version[n] slots at N, unverified",
    "stepFields": "from = state that serves the response; error = JSON-RPC error code instead of a result; forged = proof does not verify against any root; keys = the proof covers different keys than requested"
  },
  "states": {
    "A": {
      "number": 100,
      "blockHash": "H_A",
      "root": "R_A",
      "website": {
        "versionCount": 1,
        "currentVersion": 1,
        "versions": {
          "1": {
            "status": 1,
            "manifestHash": "M_A1"
          }
        }
      }
    },
    "B": {
      "number": 100,
      "blockHash": "H_B",
      "root": "R_B",
      "note": "reorg sibling of A at the same height; v1 was re-created with different content",
      "website": {
        "versionCount": 2,
        "currentVersion": 2,
        "versions": {
          "1": {
            "status": 1,
            "manifestHash": "M_B1"
          },
          "2": {
            "status": 1,
            "manifestHash": "M_B2"
          }
        }
      }
    },
    "C": {
      "number": 100,
      "blockHash": "H_C",
      "root": "R_C",
      "note": "violates the contract invariant (current version revoked); impossible for a conforming contract",
      "website": {
        "versionCount": 1,
        "currentVersion": 1,
        "versions": {
          "1": {
            "status": 2,
            "manifestHash": "M_C1"
          }
        }
      }
    },
    "D": {
      "number": 100,
      "blockHash": "H_D",
      "root": "R_D",
      "website": {
        "versionCount": 1,
        "currentVersion": 0,
        "versions": {
          "1": {
            "status": 0,
            "manifestHash": "M_D1"
          }
        }
      }
    }
  },
  "budget": {
    "perAttempt": "1 anchor (light) + at most 2 eth_getProof (heavy, RESP_MAX class FD:L1960)",
    "perLoadMax": {
      "attempts": 4,
      "anchorCalls": 4,
      "proofCalls": 8
    },
    "assumption": "Unmeasured. The per-connection token bucket (20/s, capacity 20, FD:L1967) and HEAVY_ACTIVE = 4 node-wide (FD:L1966) also serve chunk fetches; E03 must measure whether a 4 MiB site load plus proofs avoids -32021."
  },
  "scenarios": [
    {
      "id": "SNAP-01-steady",
      "mechanism": "P20",
      "request": {
        "kind": "default"
      },
      "script": [
        {
          "call": "anchor",
          "from": "A"
        },
        {
          "call": "proof1",
          "from": "A"
        },
        {
          "call": "proof2",
          "from": "A"
        }
      ],
      "expected": {
        "result": "render",
        "restarts": 0,
        "frames": 1,
        "mixed": false,
        "anchorState": "A",
        "version": 1,
        "manifestHash": "M_A1",
        "calls": [
          "anchor",
          "proof1",
          "proof2"
        ]
      }
    },
    {
      "id": "SNAP-02-A-B",
      "mechanism": "P20",
      "request": {
        "kind": "default"
      },
      "description": "Reorg between round 1 and round 2: the round-2 proof comes from B and does not verify against R_A.",
      "script": [
        {
          "call": "anchor",
          "from": "A"
        },
        {
          "call": "proof1",
          "from": "A"
        },
        {
          "call": "proof2",
          "from": "B"
        },
        {
          "call": "anchor",
          "from": "B"
        },
        {
          "call": "proof1",
          "from": "B"
        },
        {
          "call": "proof2",
          "from": "B"
        }
      ],
      "expected": {
        "result": "render",
        "restarts": 1,
        "frames": 1,
        "mixed": false,
        "anchorState": "B",
        "version": 2,
        "manifestHash": "M_B2",
        "calls": [
          "anchor",
          "proof1",
          "proof2",
          "anchor",
          "proof1",
          "proof2"
        ]
      }
    },
