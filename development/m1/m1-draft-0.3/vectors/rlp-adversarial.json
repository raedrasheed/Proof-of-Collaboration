      "description": "List body is 1 byte (0x81); the child string header declares 1 more byte, which lies outside the parent but inside the input. The child header is rejected before its body is read.",
      "expected": {
        "result": "reject",
        "firstRule": "decode.truncated",
        "stage": "decode",
        "requests": 0
      },
      "expected02": {
        "rule": "decode.noncanonical",
        "why": "0.2 bounded children by the input end, read the body 0x05 and reported a wrapped single byte"
      }
