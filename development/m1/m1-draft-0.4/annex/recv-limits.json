      "limit": 65536,
      "class": "capped",
      "label": "B"
    },
    {
      "methods": [
        "pocol_getLogs"
      ],
      "limit": 8388608,
      "class": "exact (LN)",
      "worstFormula": "RESP_MAX",
      "label": "B"
    },
    {
      "methods": [
        "eth_getProof(Website, k<=6 keys)"
      ],
      "limit": 524288,
      "class": "exact (conditional)",
      "label": "P (CR-M1-01)",
      "worstFormula": "(k+1) * 65 * (2*564 + 5) + 4096 with k = 6",
      "premises": [
        "PR-1: the state and storage tries are hexary Merkle-Patricia tries keyed by keccak256 of the 32-byte key (64 nibbles), with Ethereum node encoding",
        "PR-2: a JSON proof element is a quoted 0x-hex string of the node RLP, followed by a comma"
      ],
      "premiseStatus": "NOT stated in the baseline. FD:L921 gives 'trie node = 32+4+RLP' (a storage record); FD:L935 gives P(d) = 568d+186+32(d+1) without defining P or d and without a depth bound. 568 = 32+4+532 matches a storage record of a full branch node, so P(d) is read as a per-path storage cost, not a proof-size bound. The bound here therefore rests on PR-1 and PR-2, which E03 must confirm."
    }
  ],
  "proofBoundDerivation": {
    "pathNodes": "Under PR-1 every branch node consumes exactly 1 nibble of the 64-nibble key path, every extension node at least 1, and a leaf ends the path: at most 64 + 1 = 65 nodes per proof path. Absence proofs end earlier.",
    "nodeBytes": "Largest node: a branch with 16 hash references (16 x 33 B) and a value slot of at most 33 B: body 561, list header 3, total 564 B. Leaves and extensions are smaller (account leaf <= 148 B).",
    "jsonPerNode": "2*564 hex characters + '0x' + 2 quotes + 1 comma = 1133 B",
    "perPath": "65 * 1133 = 73645 B",
    "perRequest": "(k + 1) paths: one account proof plus k storage proofs; fixed fields and the JSON-RPC envelope are bounded by 4096 B (address, balance, codeHash, nonce, storageHash and per-key key/value strings: <= 400 + 6*200 B, plus <= 1024 B envelope, rounded up)",
    "values": {
      "k1": 151386,
      "k6": 519611
    },
    "proposedLimit": 524288,
    "round1Keys": 1,
    "round2Keys": 6
  },
