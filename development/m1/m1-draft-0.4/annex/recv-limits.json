  "baseline": "FD:L1253-1276 (table), FD:L1261 (assumptions: compact JSON, 69 B per u256 quantity with its comma, 32 B per decimal percentile), FD:L979 (RecvFit), FD:L2359-2361, BG1/D100 vectors FD:L2610-2616, RF1-RF4 FD:L3294-3298, CP values FD:L2246-2247.",
  "cpNetwork": {
    "B_code_max": 32768,
    "BODY_MAX": 196608,
    "TX_MAX": 131072,
    "LOG_BLOCK_MAX": 32768,
    "RESP_MAX": 8388608,
    "genesisPreMax": 47104,
    "source": "FD:L2246-2247, FD:L819, FD:L1960, FD:L1266"
  },
  "rows": [
    {
      "methods": [
        "eth_chainId",
        "net_version",
