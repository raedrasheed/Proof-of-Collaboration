      "label": "B"
    },
    {
      "methods": [
        "eth_getTransactionReceipt"
      ],
      "limit": 348160,
      "class": "exact",
      "worstFormula": "2*LOG_BLOCK_MAX + 546*512 + 2048",
      "baselineValue": 347136,
      "label": "B"
