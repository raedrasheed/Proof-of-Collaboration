  "budget": {
    "rules": "Per load: at most 4 attempts (3 restarts). Each attempt sends anchor (LN), proof1, proof2. A -32021 with a valid retryAfterMs waits that long and resends the same request with the same anchor; at most 3 such retries per request (FD:L1004 precedent), the 4th -32021 fails the attempt. Cumulative wait per load at most 20000 ms (P); exceeding it ends the load as 'unavailable' with zero frames. Worst case sends per load: 4 x 3 x (1+3) = 48.",
    "cases": [
      {
        "id": "BUD-1-one-retry",
        "script": [
          {
            "ok": true
          },
          {
            "ok": true
          },
          {
            "retry": 500
          },
          {
            "ok": true
          }
        ],
        "expected": {
          "result": "render",
          "sends": 4,
          "delayMs": 500,
          "restarts": 0
        }
      },
      {
        "id": "BUD-2-retries-exhaust-attempt",
        "script": [
          {
            "ok": true
          },
          {
            "retry": 100
          },
          {
            "retry": 100
          },
          {
            "retry": 100
          },
          {
            "retry": 100
          },
          {
            "ok": true
          },
          {
            "ok": true
          },
          {
            "ok": true
          }
        ],
        "expected": {
          "result": "render",
          "sends": 8,
          "delayMs": 300,
          "restarts": 1
        }
      },
      {
        "id": "BUD-3-delay-cap",
        "script": [
          {
            "ok": true
          },
          {
            "retry": 10000
          },
          {
            "retry": 10000
          },
          {
            "retry": 1
          }
        ],
        "expected": {
          "result": "unavailable",
          "sends": 4,
          "delayMs": 20000,
          "restarts": 0
        }
      },
      {
        "id": "BUD-4-fail-then-render",
        "script": [
          {
            "ok": true
          },
          {
            "fail": "outsideKeff"
          },
          {
            "ok": true
          },
          {
            "ok": true
          },
          {
            "ok": true
          }
        ],
        "expected": {
          "result": "render",
          "sends": 5,
          "delayMs": 0,
          "restarts": 1
        }
      },
      {
        "id": "BUD-5-worst-sends",
        "script": "@worst",
        "expected": {
          "result": "inconsistent",
          "sends": 48,
          "restarts": 3
        }
      },
      {
        "id": "BUD-6-no-website-ends",
        "script": [
          {
            "ok": true
          },
          {
            "noWebsite": true
          }
        ],
        "expected": {
          "result": "noWebsite",
          "sends": 2,
          "restarts": 0
        }
      },
      {
        "id": "BUD-7-invariant-ends",
        "script": [
          {
            "ok": true
          },
          {
            "ok": true
          },
          {
            "invariant": "state.statusDomain"
          }
        ],
        "expected": {
          "result": "stateInvariant",
          "sends": 3,
          "restarts": 0
        }
      }
    ],
    "worstScriptNote": "@worst = in each of 4 attempts: anchor and proof1 each get 3 x -32021 (0 ms) then succeed; proof2 gets 4 x -32021, which fails the attempt. Built by the runner; sends = 4 x (4 + 4 + 4) = 48."
  }
