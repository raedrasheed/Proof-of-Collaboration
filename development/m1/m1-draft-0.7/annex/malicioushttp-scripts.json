{
  "schema": "pocol-m1-malicioushttp/1",
  "specVersion": "M1 draft 0.7",
  "revision": "R7-04 (R2, R4)",
  "baseline": "FD:L3266-3330 (MR setup, common criterion, MR1-MR12, MR10a-f, CAP1, RF1-RF4, MR-neg), FD:L4943 (MaliciousHttp).",
  "wireFormat": "P: MaliciousHttp answers the scripted request with: the status line and headers given, each terminated by CRLF, an empty line, then the body segments in order. A segment is {text} (UTF-8), {hex} (raw bytes) or {repeat: one character, count, chunk} (written in pieces of `chunk` bytes at the scripted rate). Without Content-Length the body is delimited by closing the connection (Connection: close). Byte-exactness: the whole response is fully determined by this file; large repeats are expressed by count, not expanded.",
  "commonHead": [
    "HTTP/1.1 200 OK",
    "Content-Type: application/json",
    "Connection: close"
  ],
  "commonCriterion": "B: the exact error code; zero partial content reaches a frame, sink or viewer; TestHooks.recvStats.maxBuffered <= recvLimit + the recorded maximum piece; reservation released within 100 ms of settling; worker ping p99 <= 100 ms (C).",
  "evidenceSplit": "'model' = checked now by tools/recvguard_ref.py on these literal scripts (sizes, step, outcome, truncation). 'future' = needs Chrome, real sockets, the worker and TestHooks (Phase A); not executed.",
  "scripts": [
    {
      "id": "MR1",
      "method": "eth_blockNumber",
      "recvLimit": 4096,
      "body": [
        {
          "text": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\""
        },
        {
          "repeat": "a",
          "count": 314572800,
          "chunk": 65536
        }
      ],
      "rate": "maximum",
      "expected": {
        "outcome": "recvLimit",
        "frameCode": -32603,
        "data": {
          "reason": "recvLimit"
        },
        "bytesCountedAtMost": 4096
      },
      "model": [
        "outcome",
        "bytesCounted"
      ],
      "future": [
        "actual bytes sent before the abort (recorded)",
        "release within 100 ms"
      ]
    },
    {
      "id": "MR2",
      "method": "eth_blockNumber",
      "recvLimit": 4096,
      "body": [
        {
          "text": "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32000,\"message\":\"x\",\"data\":\""
        },
        {
          "repeat": "a",
          "count": 314572800,
          "chunk": 65536
        }
      ],
      "expected": {
        "outcome": "recvLimit"
      },
      "model": [
        "outcome"
      ]
    },
    {
      "id": "MR3",
