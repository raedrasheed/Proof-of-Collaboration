  "capAndFit": {
    "CAP1": "future (anvil-br, Blob contract): eth_call to Blob(262144) then Blob(1048576); expected from the recorded body length B: B <= 1048576 -> success with byte equality, else recvLimit; recorded in T12 as a producer limit (FD:L3290-3293)",
    "RF1-RF4": "model: m1-draft-0.4/annex/recv-limits.json recvFit (RF3, RF4) and the network profile; RF2 (end/full) needs the end/full CP file values (pending)"
  },
  "MR10": "model: vectors/mr10-cases.json with tools/recvguard_ref.Pools (MR10a, b, c, f); MR10d partly model (reservations and pending), partly future (Chrome memory); MR10e = BR20d",
  "MRneg": "recvNoLimit must fail MR1 and MR4: the model reads the same scripts with no limit for the first 8192 counted bytes and must count more than 4096"
