  "requestIds": {"eth_blockNumber": 1, "pocol_getHeaders": 2, "retry": 2, "convention": "P-V1-11 (DELEGATED-M1-CONVENTIONS-030)"},
  "tokens": {
    "S1BN": "@saved:sha:SHA-S1:0 (reviewed 0.27 transcript; result 0x1, id 1)",
    "S1HDR": "@saved:sha:SHA-S1:1 (reviewed 0.27 transcript; saved verdict ok, n 1)",
    "BN20": "@saved:c32:C32-ok-busy250:first",
    "HDR20": "@saved:c32:C32-ok-busy250:last",
    "@RS1": "JSON string of the result of S1HDR",
    "busy:<ms>": "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32021,\"message\":\"busy\",\"data\":{\"reason\":\"busy\",\"retryAfterMs\":<ms>}}}"
  },
  "builders": {
    "pairs": "object text from [key, raw JSON value] pairs in order (duplicates possible); '@RS1' is replaced by the S1 result string",
    "padTo": "[token, n]: the token's text followed by spaces to exactly n UTF-8 bytes (runner asserts the length)",
    "depthBusy": "busy reply whose data carries 'pad' = nested arrays so the whole reply has exactly this container depth (runner asserts json_depth)",
    "busyDataBytes": "busy reply whose error.data compact UTF-8 encoding is exactly this many bytes (runner asserts)",
    "busyMessageUnits": "busy reply whose message has this many UTF-16 units",
    "seq": "concatenation of {t: text} and {h: hex bytes} segments",
    "bom": "UTF-8 BOM bytes followed by the token's text",
    "text": "literal text"
  },
