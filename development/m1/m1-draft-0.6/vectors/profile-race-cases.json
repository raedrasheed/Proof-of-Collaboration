  "scenarios": [
    {
      "id": "Q8",
      "steps": [
        [
          "submit",
          [
            "addProfile",
            "B"
          ]
        ],
        [
          "accept",
          "r1"
        ]
      ],
      "expected": {
        "r1": {
          "state": "cancelled",
          "code": 4100
        },
        "signs": 0,
        "sends": 0,
        "epoch": 1,
        "conflicting": [
          "A",
          "B"
        ],
        "logHas": [
          [
            "cancelled",
            "r1",
            4100,
            "atCommit"
          ],
          [
            "acceptNoEffect",
            "r1"
          ]
        ]
      }
    },
    {
      "id": "Q9a",
      "steps": [
        [
          "submit",
          [
            "addProfile",
            "B"
          ]
        ],
        [
          "accept",
          "r1"
        ]
      ],
      "expected": {
        "r1": {
          "state": "cancelled",
          "code": 4100
        },
        "signs": 0,
        "sends": 0
      },
      "note": "B's request reaches the worker before the acceptance asks for the lock (FIFO): B commits first. The re-evaluation at commit cancels r1; step 1 is the second line of defence."
    },
    {
      "id": "Q9b",
      "steps": [
        [
          "acceptDuring",
          "r1",
          [
            [
              "addProfile",
              "B"
            ]
          ]
        ],
        [
          "request",
          "r2",
          "A"
        ]
      ],
      "expected": {
        "r1": {
          "state": "sent"
        },
        "signs": 1,
        "sends": 1,
        "epoch": 1,
        "conflicting": [
          "A",
          "B"
        ],
        "r2": {
          "state": "rejected",
          "code": 4100
        },
        "logHas": [
          [
            "sentBefore",
            "r1",
            [
              "addProfile"
            ]
          ]
        ]
      },
      "note": "B is submitted while the acceptance holds the lock (the hook delays the identity check by 2 s); B waits, then commits after the release."
    },
    {
      "id": "Q9c-before-step3",
      "steps": [
        [
          "acceptRaw",
          "r1",
          "beforeStep3",
          {
            "pid": "B",
            "profile": "B"
          }
        ]
      ],
      "expected": {
        "r1": {
          "state": "cancelled",
          "code": 4100
        },
        "signs": 0,
        "sends": 0,
        "epoch": 1
      },
      "note": "direct write to profiles: B before step 3; step 3 re-reads storage (P) and sees the conflict; onChanged is processed after the release"
    },
    {
      "id": "Q9c-after-step3",
      "steps": [
        [
          "acceptRaw",
          "r1",
          "afterStep3",
          {
            "pid": "B",
            "profile": "B"
          }
        ]
      ],
      "expected": {
        "r1": {
          "state": "sent"
        },
        "signs": 1,
        "sends": 1,
        "epoch": 1,
        "logHas": [
          [
            "declaredLimit",
            "rawWriteAfterStep3",
            "r1"
          ]
        ]
      },
      "note": "declared limit (H): a bypassing write after step 3 is detected only afterwards"
