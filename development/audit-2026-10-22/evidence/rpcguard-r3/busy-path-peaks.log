# --- source of the scratch test ---
    #[test] fn zz_scratch_busy_peaks(){
        let member=|id:&str|format!(r#"{{"jsonrpc":"2.0","id":{id},"method":"eth_call","params":[]}}"#);
        let batch=|id:&str|format!("[{}]",vec![member(id);20].join(","));
        let s128=format!("\"{}\"",&"i".repeat(126));
        let arr1k=format!("[{}0]","0,".repeat(511));
        let obj1k=format!("{{{}\"z\":0}}",(0..120).map(|k|format!("\"k{k:03}\":0,")).collect::<String>());
        let nest_arr64=format!("{}{}","[".repeat(64),"]".repeat(64));
        let nest_obj25=format!("{}0{}","{\"\":".repeat(25),"}".repeat(25));
        let nest_obj127=format!("{}0{}","{\"\":".repeat(127),"}".repeat(127));
        let flat_obj=format!("{{{}}}",(0..21).map(|k|format!("\"{}\":0",(b'a'+k as u8) as char)).collect::<Vec<_>>().join(","));
        let flat_arr=format!("[{}]",vec!["0";63].join(","));
        let ws_arr=format!("[{}0]","0  ,  ".repeat(63));
        let objs=format!("[{}]",vec!["{\"a\":0}";18].join(","));
        let objs1k=format!("[{}]",vec!["{\"a\":0}";127].join(","));
        let strk=format!("\"{}\"","\\u0041".repeat(170));
        for (name,id) in [("s128",&s128),("arr1k",&arr1k),("obj1k",&obj1k),("nestArr64",&nest_arr64),("nestObj25",&nest_obj25),("nestObj127",&nest_obj127),
            ("flatObj21",&flat_obj),("flatArr63",&flat_arr),("wsArr",&ws_arr),("objs18",&objs),("objs127",&objs1k),("esc1k",&strk)]{
            let b=batch(id);let (a,peak)=crate::alloc_meter::peak(||super::busy(b.as_bytes()));
            let one=member(id);let (_,p1)=crate::alloc_meter::peak(||super::busy(one.as_bytes()));
            println!("ZZPEAK {name} raw={} batchPeak={peak} singlePeak={p1} answer={} kept={}",id.len(),a.len(),!a.contains("\"id\":null"));
        }
    }
