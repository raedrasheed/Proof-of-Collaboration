# each mutant: one source edit (two for M3a) in pocold src/node.rs or src/chain.rs, or lp4-execution src/user_phase.rs, then
#   (cd prototypes/<crate> && CARGO_TARGET_DIR=<own> flock <cpu.lock> cargo test --release --locked --no-fail-fast <args in brackets>)
