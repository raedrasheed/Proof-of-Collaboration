# E1M7 an extension is encoded with the leaf flag: lp4-execution/src/state_trie.rs: replace 'rlp_bytes(&compact(first_key(n),d,at,false),&mut p)' with 'rlp_bytes(&compact(first_key(n),d,at,true),&mut p)'
# E1M8 a branch's children are referenced at the branch's own depth: lp4-execution/src/state_trie.rs: replace 'p.extend_from_slice(node_ref(c,at+1).bytes())' with 'p.extend_from_slice(node_ref(c,at).bytes())'
# E1M9 the touched set ignores a code hash change: lp4-execution/src/state_trie.rs: replace '||old.info.code_hash!=new.info.code_hash{t.account(*a)}' with '{t.account(*a)}'
# E1M10 an inserted key that leaves a branch's prefix is not split off: lp4-execution/src/state_trie.rs: replace '            if p<at{\n                let own' with '            if false&&p<at{\n                let own'
# E1M11 a rebuild carries the previous block's trie forward: pocold/src/chain.rs: replace 'let mut next=e;next.state=out.state;next.trie=Some(out.trie);' with 'let mut next=e;next.state=out.state;next.trie=p.trie.clone();let _=out.trie;'
# E1M12 no trie is ever derived (TRIE_PATH_MAX 0): pocold/src/chain.rs: replace 'pub const TRIE_PATH_MAX:usize=64;' with 'pub const TRIE_PATH_MAX:usize=0;'
# E1M13 a removed account keeps its world leaf: lp4-execution/src/state_trie.rs: replace 'let Some(a)=db.accounts.get(addr).filter(|a|exists(a)) else{ch.push((k,None));continue};' with 'let Some(a)=db.accounts.get(addr).filter(|a|exists(a)) else{continue};'
