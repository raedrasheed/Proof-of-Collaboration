# E1M3 a derived trie is used without the committed-root check: pocold/src/chain.rs: replace 'if t.root().0!=want{self.trie_refused' with 'if false&&t.root().0!=want{self.trie_refused'
# E1M4 a parent's own trie is used without the committed-root check: pocold/src/chain.rs: replace 'if let Some(t)=&p.trie{if t.root().0==want{return Some(t.clone())}' with 'if let Some(t)=&p.trie{if true{return Some(t.clone())}'
# E1M5 settle drops the head's trie too: pocold/src/chain.rs: replace 'for e in self.blocks.values_mut(){if e.hash!=head{e.trie=None;}}' with 'for e in self.blocks.values_mut(){let _=head;e.trie=None;}'
