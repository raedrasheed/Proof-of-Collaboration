{
 "alternatives": {
  "A": "net changes counted; a halt whose nonce/fee residue does not fit makes the block invalid (recommended)",
  "A-touched": "as A, but touched accounts without a net change also count",
  "B": "net changes counted; the halt residue is exempt from the limit"
 },
 "constants": {
  "ACCT_DIRTY_BLOCK_MAX": 2048
 },
 "recommended": "A",
 "rule": "D-A03-DIRTY",
 "scenarios": [
  {
   "expected": {
    "A": {
     "blockValid": true,
     "dirtyAccounts": 2048,
     "txs": [
      {
       "status": 1
      }
     ]
    },
    "A-touched": {
